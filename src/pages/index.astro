---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Publications from "../components/Publications.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

import site from "../data/site.json";
import services from "../data/services.json";
import publications from "../data/publications.json";
---
<Base title={site.meta.title} description={site.meta.description}>
  <link rel="preload" href="/ot-it-stack.svg" as="image" type="image/svg+xml" slot="head" />
  <Nav links={site.nav.links} cta={site.nav.cta} />
  <Hero hero={site.hero} />
  <Services services={services} />
  <Publications publications={publications} />
  <Contact contact={site.contact} />
  <Footer footer={site.footer} />
</Base>
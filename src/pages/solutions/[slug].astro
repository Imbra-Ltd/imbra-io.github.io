---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import site from "../../data/site.json";
import services from "../../data/services.json";
import solutions from "../../data/solutions.json";

export function getStaticPaths() {
  return solutions.items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const { labels, evidence } = solutions;
const pillars = services.filter((p) => item.pillars.includes(p.id));

// Search engines read the page's position from this; visitors use the "← Solutions" nav link.
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: solutions.meta.title, item: new URL("/solutions/", Astro.site).href },
    { "@type": "ListItem", position: 3, name: item.title, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};
---
<Base title={`${item.metaTitle} — ${site.meta.title}`} description={item.summary}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumb)} />
  <Nav links={solutions.nav.page} cta={site.nav.cta} />

  <main class="solution-page">
    <header class="solution-header">
      <div class="solution-label mono">{[solutions.intro.label, ...pillars.map((p) => p.title)].join(" · ")}</div>
      <h1 class="solution-heading">{item.heading}<br /><strong>{item.headingStrong}</strong></h1>
      <p class="solution-intro">{item.intro}</p>
    </header>

    <section class="solution-row">
      <h2 class="solution-row-label">{labels.problem}</h2>
      <div class="solution-row-body">
        <ul class="solution-list">
          {item.symptoms.map((s) => <li>{s}</li>)}
        </ul>
        <p class="solution-text">{item.impact}</p>
      </div>
    </section>

    <section class="solution-row">
      <h2 class="solution-row-label">{labels.systems}</h2>
      <div class="solution-row-body">
        <div class="solution-tags">
          {item.systems.map((s) => <span class="solution-tag">{s}</span>)}
        </div>
      </div>
    </section>

    <section class="solution-row">
      <h2 class="solution-row-label">{labels.approach}</h2>
      <div class="solution-row-body">
        <ol class="solution-steps">
          {item.approach.map((s) => <li>{s}</li>)}
        </ol>
      </div>
    </section>

    <section class="solution-row">
      <h2 class="solution-row-label">{labels.example}</h2>
      <div class="solution-row-body solution-example">
        <span class="solution-evidence">{evidence[item.example.evidence]}</span>
        <p class="solution-text">{item.example.text}</p>
      </div>
    </section>

    <section class="solution-row">
      <h2 class="solution-row-label">{labels.deliverables}</h2>
      <div class="solution-row-body">
        <ul class="solution-list">
          {item.deliverables.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </section>

    <section class="solution-row">
      <h2 class="solution-row-label">{labels.boundaries}</h2>
      <div class="solution-row-body">
        <ul class="solution-list">
          {item.boundaries.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </section>

    <section class="solution-row">
      <h2 class="solution-row-label">{labels.experience}</h2>
      <div class="solution-row-body">
        <span class="solution-evidence">{evidence[item.experience.evidence]}</span>
        <ul class="solution-list">
          {item.experience.items.map((e) => <li>{e}</li>)}
        </ul>
      </div>
    </section>

    <section class="solution-row">
      <h2 class="solution-row-label">{labels.pricing}</h2>
      <div class="solution-row-body">
        <p class="solution-text" set:html={labels.pricingNote} />
      </div>
    </section>
  </main>

  <Contact contact={site.contact} />
  <Footer footer={site.footer} />
</Base>

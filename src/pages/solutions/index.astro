---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import site from "../../data/site.json";
import services from "../../data/services.json";
import solutions from "../../data/solutions.json";

const { intro } = solutions;

// A page listed under two pillars appears in both groups; a pillar without pages is left out.
const groups = services
  .map((pillar) => ({ pillar, items: solutions.items.filter((s) => s.pillars.includes(pillar.id)) }))
  .filter((g) => g.items.length > 0);
---
<Base title={`${solutions.meta.title} — ${site.meta.title}`} description={solutions.meta.description}>
  <Nav links={solutions.nav.index} cta={site.nav.cta} />

  <main class="solution-page">
    <header class="solution-header">
      <div class="solution-label mono">{intro.label}</div>
      <h1 class="solution-heading">{intro.heading}<br /><strong>{intro.headingStrong}</strong></h1>
      <p class="solution-intro">{intro.sub}</p>
    </header>

    {groups.map(({ pillar, items }) => (
      <section class="solutions-group">
        <h2 class="solutions-pillar-title">{pillar.title}</h2>
        <p class="solutions-pillar-desc">{pillar.desc}</p>
        <ul class="solutions-items">
          {items.map((s) => (
            <li class="solutions-item">
              <h3 class="solutions-item-title"><a href={`/solutions/${s.slug}/`}>{s.title}</a></h3>
              <p class="solutions-item-summary">{s.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>

  <Contact contact={site.contact} />
  <Footer footer={site.footer} />
</Base>

---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import ContactForm from "../components/interactive/ContactForm.tsx";
import site from "../data/site.json";
import pricing from "../data/pricing.json";
import Breadcrumb from "../components/Breadcrumb.astro";

---

<Base title={`${pricing.meta.title} — ${site.meta.title}`} description={pricing.meta.description}>
  <Breadcrumb name={pricing.meta.title} slot="head" />
  <Nav links={site.nav.links} cta={site.nav.cta} />

  <main class="pricing-page">
    <div class="pricing-header">
      <div class="pricing-label mono">{pricing.intro.label}</div>
      <h1 class="pricing-heading">{pricing.intro.heading}</h1>
      <p class="pricing-sub">{pricing.intro.sub}</p>
    </div>

    {pricing.categories.map((cat) => (
      <section class="pricing-section" id={cat.id}>
        <div class="pricing-section-header">
          <span class="pricing-index mono">{cat.index}</span>
          <div>
            <h2 class="pricing-section-title">{cat.title}</h2>
            <div class="pricing-model mono">{cat.model}</div>
          </div>
        </div>

        {[].concat(cat.desc).map((p) => <p class="pricing-desc">{p}</p>)}
        {cat.guarantee && (
          <p class="pricing-desc"><strong>{cat.guarantee}</strong></p>
        )}
        {cat.callout && (
          <div class="pricing-callout">
            <div class="pricing-callout-icon">i</div>
            <p class="pricing-callout-text">{cat.callout}</p>
          </div>
        )}

        {cat.tiers && (
          <div class="pricing-tiers" style={{ "--tier-cols": cat.tiers.length }}>
            {cat.tiers.map((tier) => (
              <div class={`pricing-tier${tier.highlight ? ' pricing-tier--highlight' : ''}`}>
                <div class="pricing-tier-name mono">{tier.name}</div>
                <div class="pricing-tier-price">{tier.price}</div>
                <div class="pricing-tier-period">{tier.period}</div>
                <ul class="pricing-tier-features">
                  {tier.features.map((f) => <li>{f}</li>)}
                </ul>
              </div>
            ))}
          </div>
        )}

        {cat.terms && (
          <div class="pricing-rates">
            {cat.terms.map((t) => (
              <div class="pricing-rate-row">
                <span class="pricing-rate-label">{t.label}</span>
                <span class="pricing-rate-value">{t.value}</span>
              </div>
            ))}
          </div>
        )}

        {cat.notes && (
          <details class="pricing-notes-details">
            <summary class="pricing-notes-summary mono">Notes</summary>
            <ol class="pricing-notes">
              {cat.notes.map((n) => <li>{n}</li>)}
            </ol>
          </details>
        )}
      </section>
    ))}

    {pricing.examples && (
      <section class="pricing-section" id="scenarios">
        <div class="pricing-section-header">
          <span class="pricing-index mono">{pricing.categories.length + 1}</span>
          <div>
            <h2 class="pricing-section-title">{pricing.examples.title}</h2>
            <div class="pricing-model mono">{pricing.examples.model}</div>
          </div>
        </div>
        <div class="pricing-scenarios-grid">
          {pricing.examples.items.map((s) => (
            <div class="pricing-scenario">
              <div class="pricing-scenario-title mono">{s.title}</div>
              <p class="pricing-scenario-desc">{s.desc}</p>
              <div class="pricing-scenario-lines">
                {s.lines.map((l) => (
                  <div class="pricing-scenario-line">
                    <span class="pricing-scenario-line-label">{l.label}</span>
                    <span class="pricing-scenario-line-amount mono">{l.amount}</span>
                  </div>
                ))}
              </div>
              <div class="pricing-scenario-total">
                <span>Total</span>
                <span class="mono">{s.total}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <p class="pricing-legal-note">{pricing.legalNote}</p>

    <section class="pricing-cta" id="contact">
      <h2 class="pricing-cta-heading">{pricing.cta.heading}</h2>
      <p class="pricing-cta-sub">{pricing.cta.sub}</p>
      <ContactForm client:load endpoint={site.contact.formEndpoint} />
    </section>
  </main>
</Base>

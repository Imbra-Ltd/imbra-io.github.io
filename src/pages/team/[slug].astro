---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import site from "../../data/site.json";
import team from "../../data/team.json";
import Breadcrumb from "../../components/Breadcrumb.astro";

export function getStaticPaths() {
  return team.members.map((m) => ({ params: { slug: m.slug }, props: { member: m } }));
}

const { member } = Astro.props;
---
<Base title={`${member.name} — ${site.meta.title}`} description={`${member.name}, ${member.role} at Imbra. ${member.discipline}`}>
  <Breadcrumb name={member.name} slot="head" />
  <Nav links={site.nav.links} cta={site.nav.cta} />

  <main class="legal-page">
    <a class="team-back" href="/team/">{team.backLabel}</a>
    <div class="legal-label mono">{member.role}</div>
    <h1 class="legal-heading">{member.name}</h1>

    <div class="legal-grid">
      <div class="legal-section">
        <h2 class="legal-section-title">Background</h2>
        <div class="legal-section-body">
          {member.bio.map((p) => <p>{p}</p>)}
          <p><a href={member.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn →</a></p>
        </div>
      </div>

      {member.publications.length > 0 && (
        <div class="legal-section">
          <h2 class="legal-section-title">Publications</h2>
          <div class="legal-section-body">
            <ul class="pub-list">
              {member.publications.map((p) => (
                <li class="pub-item">
                  <a class="pub-title" href={p.doi} target="_blank" rel="noopener noreferrer">{p.title}</a>
                  <div class="pub-meta mono">{[p.journal, p.year, p.vol].filter(Boolean).join(" · ")}</div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
    </div>

    <a href={team.profileCta.href} class="btn-primary about-cta">{team.profileCta.label}</a>
  </main>
</Base>

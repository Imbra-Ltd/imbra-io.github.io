---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";
import book from "../data/book.json";
import Nav from "../components/Nav.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

// The scheduling provider is only named once booking is live, so the policy
// never describes a service the site does not yet reach.
const bookable = book.booking.url !== "";
---
<Base title={`Privacy Policy — ${site.meta.title}`} description="How imbra.io handles contact form submissions and third-party services.">
  <Breadcrumb name="Privacy Policy" slot="head" />
  <Nav links={site.nav.links} cta={site.nav.cta} />

  <main class="legal-page">
    <div class="legal-label">Legal</div>
    <h1 class="legal-heading">Privacy Policy</h1>

    <div class="legal-grid">
      <div class="legal-section">
        <div class="legal-section-title">Last updated</div>
        <div class="legal-section-body">
          <p>September 2026</p>
        </div>
      </div>

      <div class="legal-section">
        <div class="legal-section-title">Controller</div>
        <div class="legal-section-body">
          <p>Imbra Ltd.<br />ul. Tsar Simeon I 36<br />Varna, Bulgaria</p>
          <p><a href="mailto:contact@imbra.io">contact@imbra.io</a></p>
        </div>
      </div>

      <div class="legal-section">
        <div class="legal-section-title">Data collected</div>
        <div class="legal-section-body">
          <p>This website collects data only when you submit the contact form. The information you provide (name, email address, and message) is transmitted to Formspree and forwarded to our email address. We do not store this data ourselves.</p>
          <p>No user accounts, cookies, or tracking pixels are used.</p>
        </div>
      </div>

      <div class="legal-section">
        <div class="legal-section-title">Third-party services</div>
        <div class="legal-section-body">
          <p><strong>Google Fonts</strong> — Typography is loaded from Google's servers. When you visit this site, your browser makes a request to Google, which may log your IP address. See <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google's Privacy Policy</a>.</p>
          <p><strong>GitHub Pages</strong> — This site is hosted on GitHub Pages. GitHub may collect technical data such as IP addresses as part of its hosting infrastructure. See <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener noreferrer">GitHub's Privacy Statement</a>.</p>
          <p><strong>Formspree</strong> — Contact form submissions are processed by Formspree and forwarded to our email address. Formspree may retain submission data in accordance with its own privacy policy. See <a href="https://formspree.io/legal/privacy-policy" target="_blank" rel="noopener noreferrer">Formspree's Privacy Policy</a>.</p>
          {bookable && (
            <p><strong>{book.booking.provider}</strong> — <span set:html={book.booking.privacy} /></p>
          )}
        </div>
      </div>

      <div class="legal-section">
        <div class="legal-section-title">Your rights</div>
        <div class="legal-section-body">
          <p>Under the General Data Protection Regulation (GDPR), you have the right to access, rectify, or erase any personal data we hold about you, as well as the right to restrict or object to its processing.</p>
          <p>To exercise these rights, contact us at <a href="mailto:contact@imbra.io">contact@imbra.io</a>.</p>
        </div>
      </div>

      <div class="legal-section">
        <div class="legal-section-title">Changes</div>
        <div class="legal-section-body">
          <p>We may update this policy as the site evolves. The date at the top of this page reflects the most recent revision.</p>
        </div>
      </div>
    </div>
  </main>
</Base>
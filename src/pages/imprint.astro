---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";
import Nav from "../components/Nav.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
---
<Base title={`Imprint — ${site.meta.title}`} description="Legal details for Imbra Ltd., registered in Varna, Bulgaria.">
  <Breadcrumb name="Imprint" slot="head" />
  <Nav links={site.nav.links} cta={site.nav.cta} />

  <main class="legal-page">
    <div class="legal-label">Legal</div>
    <h1 class="legal-heading">Imprint</h1>

    <div class="legal-grid">
      <div class="legal-section">
        <div class="legal-section-title">Company</div>
        <div class="legal-section-body">
          <p>Imbra Ltd.</p>
          <p>ul. Tsar Simeon I 36<br />Varna, Bulgaria</p>
        </div>
      </div>

      <div class="legal-section">
        <div class="legal-section-title">Registration</div>
        <div class="legal-section-body">
          <p>BULSTAT / UIC: <span class="mono">208731265</span></p>
          <p>VAT Number: <span class="mono">BG208731265</span></p>
        </div>
      </div>

      <div class="legal-section">
        <div class="legal-section-title">Represented by</div>
        <div class="legal-section-body">
          <p>Branimir Georgiev<br />Managing Director</p>
        </div>
      </div>

      <div class="legal-section">
        <div class="legal-section-title">Contact</div>
        <div class="legal-section-body">
          <p><a href="mailto:contact@imbra.io">contact@imbra.io</a></p>
        </div>
      </div>

      <div class="legal-section">
        <div class="legal-section-title">Dispute Resolution</div>
        <div class="legal-section-body">
          <p>We are not obliged to participate in dispute resolution proceedings before a consumer arbitration board.</p>
        </div>
      </div>
    </div>
  </main>
</Base>
---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import site from "../data/site.json";
import about from "../data/about.json";
import Breadcrumb from "../components/Breadcrumb.astro";
---
<Base title={`${about.meta.title} — ${site.meta.title}`} description={about.meta.description}>
  <Breadcrumb name={about.meta.title} slot="head" />
  <Nav links={site.nav.links} cta={site.nav.cta} />

  <main class="legal-page">
    <div class="legal-label">{about.label}</div>
    <h1 class="legal-heading">{about.heading}</h1>

    <div class="legal-grid">
      {about.sections.map((section) => (
        <div class="legal-section">
          <h2 class="legal-section-title">{section.title}</h2>
          <div class="legal-section-body">
            {section.paragraphs.map((p) => <p>{p}</p>)}
            {section.links?.map((l) => (
              l.href.startsWith("/")
                ? <p><a href={l.href}>{l.label}</a></p>
                : <p><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a></p>
            ))}
          </div>
        </div>
      ))}
    </div>

    <a href={about.cta.href} class="btn-primary about-cta">{about.cta.label}</a>
  </main>
</Base>

---
import HamburgerMenu from "./interactive/HamburgerMenu.tsx";
import { Image } from 'astro:assets';
import book from "../data/book.json";

interface Link { label: string; target?: string; href?: string; }
interface Cta  { label: string; target?: string; href?: string; }
interface Props { links: Link[]; cta: Cta; }

const { links, cta } = Astro.props as Props;

// Booking takes the CTA slot once a scheduling URL is configured in book.json.
// Until then every page keeps the contact CTA, so the nav never offers a
// booking that cannot be made.
const navCta = book.booking.url === "" ? cta : { label: "Book a call", href: "/book/" };

// Section links scroll, page links load. A hairline before the first page link
// marks where the behaviour changes.
const firstPageLink = links.findIndex(l => (l.href ?? "").startsWith("/") && !(l.href ?? "").startsWith("/#"));
---
<nav>
  <a class="nav-logo" href="/" aria-label="Imbra — home">
    <Image src="/logos/logo-1b-web.svg" alt="Imbra" class="nav-logo-img" width={120} height={32} />
  </a>
  <div class="nav-links">
    {links.map((l: Link, i: number) => (
      <a href={l.href ?? `#${l.target}`} class={`nav-link${i === firstPageLink ? " nav-link--group-start" : ""}`}>{l.label}</a>
    ))}
    <a href={navCta.href ?? `#${navCta.target}`} class="nav-cta">{navCta.label}</a>
  </div>
  <HamburgerMenu client:load links={links} cta={navCta} />
</nav>

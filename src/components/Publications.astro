---
const { publications } = Astro.props;
---
<section id="publications">
  <div class="reveal">
    <div class="section-label">04 — Research &amp; Credentials</div>
    <h2 class="section-heading">Grounded in <strong>engineering science</strong></h2>
    <p class="section-sub">Peer-reviewed research on advanced process control and fuzzy logic — published in indexed engineering journals.</p>
  </div>
  <ul class="pub-list reveal">
    {publications.map(p => (
      <li class="pub-item">
        <a class="pub-title" href={p.doi} target="_blank" rel="noopener noreferrer">{p.title}&nbsp;↗</a>
        <div class="pub-meta">{p.journal} · {p.year} · {p.vol}</div>
      </li>
    ))}
  </ul>
</section>

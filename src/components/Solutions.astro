---
import ServiceExpand from "./interactive/ServiceExpand.tsx";
const { solutions, header } = Astro.props;
---
<section id="solutions">
  <div class="reveal">
    <div class="section-label">{header.label}</div>
    <h2 class="section-heading">{header.heading} <strong>{header.headingStrong}</strong></h2>
    <p class="section-sub">{header.sub}</p>
  </div>
  <ServiceExpand client:load pillars={[{ services: solutions }]} idPrefix="solution" />
</section>

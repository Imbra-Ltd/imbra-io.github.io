---
interface Principle      { title: string; desc: string; }
interface OperatingModel { label: string; heading: string; headingStrong: string; sub: string; principles: Principle[]; }
interface Props          { model: OperatingModel; }

const { model } = Astro.props as Props;
---
<section id="operating-model">
  <div class="reveal">
    <div class="section-label">{model.label}</div>
    <h2 class="section-heading">{model.heading} <strong>{model.headingStrong}</strong></h2>
  </div>
  <div class="operating-model reveal">
    <p class="operating-model-sub">{model.sub}</p>
    <ul class="operating-model-list">
      {model.principles.map((p) => (
        <li class="operating-model-item">
          <h3 class="operating-model-title">{p.title}</h3>
          <p class="operating-model-desc">{p.desc}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
